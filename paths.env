# nfront: where its parts are, relative to the directory that holds this
# repository (the umbrella, ~/Devel/nfront).  Read by
# the tree's scripts/lib/paths.sh and paths.py and by the toolchains'
# scripts; a variable already set in the environment wins.  Moving the
# parts means changing this file only.
#
# the 9front tree (worktrees of one git repository)
TREE=tree
TREE_GCC=tree-gcc
TREE_NIX=tree-nix
TREE_RISCV=tree-riscv
TREE_UPSTREAM=tree-upstream
# toolchains
GCC_DIR=toolchain/gcc
RUST_DIR=toolchain/rust
GO_DIR=toolchain/go
ZIG_DIR=toolchain/zig
# tools
MCP_DIR=tools/mcp
# archives of other projects' sources (with their checksums)
DISTFILES=distfiles
# outside the umbrella (relative paths from it, ~/Devel/nfront):
# Plan 9 from User Space: rc, yacc, the generators of the host build
PLAN9PORT=../plan9port
# the references of the LinuxKPI's tools (scripts/linux): Linux's trees
# (LINUX the version vendor/ is, sys/src/linux/VERSION; LINUX_OLD the first
# LinuxKPI's) and the BSD templates' git trees
LINUX=../linux-7.3.1
LINUX_OLD=../linux-6.6
OPENBSD_SRC=../openbsd
FREEBSD_SRC=../freebsd-src
DRMKMOD_SRC=../drm-kmod

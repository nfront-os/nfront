#!/usr/bin/env python3
"""status: each part of nfront against manifest.json: where it is, its
branch and commit, whether that is the manifest's (=), changed files."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import parts

vals = parts.env()
man = parts.load()['parts']
bad = 0
for name, spec in parts.PARTS:
	d = parts.where(spec, vals)
	s = parts.state(d)
	if s is None:
		print('%-18s %-10s %-12s %s' % (name, '-', 'no repository', d))
		continue
	m = man.get(name)
	if m is None:
		mark = 'not pinned'
	elif m['commit'] == s['commit']:
		mark = '='
	else:
		ahead = parts.git(d, 'rev-list', '--count', '%s..HEAD' % m['commit'])
		mark = ('+%s' % ahead) if ahead is not None and parts.git(d, 'merge-base', '--is-ancestor', m['commit'], 'HEAD') is not None else 'differs'
		bad += 1
	dirty = (' %d changed' % s['dirty']) if s['dirty'] else ''
	print('%-18s %-10s %-12s %s%s' % (name, s['branch'], s['commit'][:10], mark, dirty))
sys.exit(1 if bad else 0)
